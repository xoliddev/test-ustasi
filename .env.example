# Copy this file to .env and fill in your own values. Never commit .env.

# Token from @BotFather (looks like 123456789:AA...). The placeholder below is NOT a real token.
BOT_TOKEN=123456789:replace-with-your-token-from-BotFather

# Public HTTPS address of this server, without a trailing slash (for example a free cloudflared tunnel).
# The Mini App opens at https://<address>/webapp/. Students solve tests there, teachers review drafts there.
PUBLIC_URL=

# Optional: a Gemini API key from Google AI Studio. With it the bot also drafts questions with AI; every drafted
# question must still quote the source word for word (checked by code) and the teacher approves before publishing.
# Leave empty and the rule-based generator drafts everything (no network at all).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Seconds to wait for a draft before falling back to the rules.
GEMINI_TIMEOUT=40
# AI drafts per teacher per Tashkent day (the rules have no limit).
AI_PER_DAY=20

# Files a teacher sends: maximum size in bytes and pages of a PDF.
FILE_MAX_BYTES=10000000
PDF_MAX_PAGES=30

# Secret for signing class invite links. Leave empty to derive one from BOT_TOKEN.
INVITE_SECRET=
# Invite links work this many days.
INVITE_DAYS=14
# Students who have not started get a reminder this many hours before the deadline.
REMIND_HOURS=2

# Where the SQLite file lives (the folder is created automatically).
DB_PATH=data/testustasi.db
# Fill an empty database with the invented class "7-B" of "Nodira ustoz" (three earlier tests). 0 = start empty.
# Seeded people have negative ids, so nobody can sign in as them.
SEED_DEMO=1

# Web server for the Mini App and its API.
HOST=0.0.0.0
PORT=8080

# Mini App login data older than this many seconds is refused.
INITDATA_MAX_AGE=3600
# Per minute: bot messages and buttons per user, Mini App calls per user (a student taps an answer every few seconds).
RATE_PER_MINUTE=30
API_RATE_PER_MINUTE=240
LOG_LEVEL=INFO
